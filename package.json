{
  "name": "chesslasso",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --import tsx server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --import tsx server/index.ts",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json && node node_modules/@typescript/native/bin/tsc -p tsconfig.server.json",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt --write . && prettier --write \"src/**/*.svelte\"",
    "format:check": "oxfmt --check . && prettier --check \"src/**/*.svelte\"",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run check && npm run lint && npm run test && npm run build && npm run format:check",
    "test:ui": "node scripts/check-ui.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@lichess-org/chessground": "^10.5.0",
    "chess.js": "^1.4.0",
    "hono": "^4.13.16",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.23",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
