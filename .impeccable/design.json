      "css": ".ds-field-label{font-family:'Manrope Variable',sans-serif;display:block;font-size:12px;font-weight:750;margin-bottom:9px;color:var(--ink,#243d44)}.ds-input{font-family:'Manrope Variable',sans-serif;font-size:14px;line-height:1.65;min-height:45px;border:1px solid #c7d3d2;border-radius:7px;background:var(--paper,#fff);color:var(--ink,#243d44);padding:12px 14px;caret-color:var(--green,#286352)}.ds-input::placeholder{color:#64767a;opacity:1}.ds-input:focus-visible{outline:3px solid var(--focus,#2d735e);outline-offset:4px}.ds-input:disabled{background:#f0f3f2}@media(width < 760px){.ds-input{font-size:16px;padding-inline:11px}}"
