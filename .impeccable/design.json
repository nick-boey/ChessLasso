      "name": "Icon action",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Compact named board or header utility.",
      "html": "<button class=\"ds-icon\" aria-label=\"Close dialog\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M6 6l12 12M18 6 6 18\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border:0;border-radius:6px;background:transparent;color:var(--ink,#243d44);cursor:pointer}.ds-icon:hover{background:#e8efed}.ds-icon:focus-visible{outline:3px solid var(--focus,#2d735e);outline-offset:4px}"
    },
    {
      "name": "Compact move entry",
      "kind": "custom",
      "refersTo": "move-entry",
      "description": "One algebraic input with named play and notation icons; 44px mobile actions.",
      "html": "<form class=\"ds-move-row\"><label class=\"ds-sr\" for=\"ds-notation\">Your move</label><input id=\"ds-notation\" placeholder=\"Nc3\" autocomplete=\"off\" spellcheck=\"false\"><button class=\"ds-play\" aria-label=\"Play move\" title=\"Play move\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"m8 5 11 7-11 7z\"/></svg></button><button class=\"ds-guide\" type=\"button\" aria-label=\"Notation guide\" title=\"Notation guide\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M12 5v15M12 5C9 3 5 3 3 4v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-2-1-6-1-9 1Z\"/></svg></button></form>",
      "css": ".ds-move-row{display:grid;grid-template-columns:minmax(0,1fr) 40px 40px;gap:4px;align-items:center;margin-top:8px}.ds-move-row input{font-family:'Manrope Variable',sans-serif;font-size:14px;line-height:1.65;min-width:0;height:40px;padding:7px 10px;border:1px solid #c7d3d2;border-radius:7px;background:var(--paper,#fff);color:var(--ink,#243d44);caret-color:var(--green,#286352)}.ds-move-row input::placeholder{color:#64767a;opacity:1}.ds-play,.ds-guide{display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:6px;cursor:pointer}.ds-play{background:var(--green,#286352);color:var(--paper,#fff)}.ds-play:not(:disabled):hover{background:#1a4e3f}.ds-guide{width:38px;height:38px;background:transparent;color:var(--ink,#243d44)}.ds-guide:hover{background:#e8efed}.ds-move-row :focus-visible{outline:3px solid var(--focus,#2d735e);outline-offset:4px}.ds-play:disabled{opacity:.5;cursor:default}.ds-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);border:0;white-space:nowrap}@media(width < 760px){.ds-move-row{grid-template-columns:minmax(0,1fr) 44px 44px}.ds-move-row input,.ds-play,.ds-guide{height:44px}.ds-play,.ds-guide{width:44px}}"
    },
