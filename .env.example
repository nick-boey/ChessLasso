# Keys stay server-side. Mock mode is the first-run default; change it in Settings.
GEMINI_API_KEY=
FIREWORKS_API_KEY=
# Verified live model; Gemini3.8 was listed but timed out at setup verification.
CHESSLASSO_MODEL=gemini-3.8-flash
# Optional local runtime paths, always outside the public source checkout.
# CHESSLASSO_RUNTIME_DIR=/absolute/path/chesslasso-runtime
# CHESSLASSO_ARCHIVE_DIR=/absolute/path/ChessLasso-coaching
CHESSLASSO_ARCHIVE_REPO=nick-boey/ChessLasso-coaching
# Add the exact HTTPS Tailscale Serve origin before remote use.
CHESSLASSO_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
# Set a strong token for remote login; otherwise generated and stored locally.
# CHESSLASSO_ACCESS_TOKEN=
# STOCKFISH_PATH=/absolute/path/to/native/stockfish
